---
layout: null
sitemap: false
---
[
{% assign docs = site.posts | concat: site.cases %}
{% assign searchable_pages = site.pages | where: "searchable", true %}
{% assign docs = docs | concat: searchable_pages %}
{% for d in docs %}
  {
    "title": {{ d.title | jsonify }},
    "url": {{ d.url | relative_url | jsonify }},
    "type": {% if d.collection == "posts" %}"文章"{% elsif d.collection == "cases" %}"個案心得"{% else %}"頁面"{% endif %},
    "topic": {{ d.topic | default: "" | jsonify }},
    "content": {{ d.content | markdownify | strip_html | normalize_whitespace | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
